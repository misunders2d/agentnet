      "format": "date-time",
      "title": "Proposal Expires At",
      "type": "string"
    },
    "proposed_at": {
      "format": "date-time",
      "title": "Proposed At",
      "type": "string"
    },
    "relationship": {
      "$ref": "#/$defs/Relationship"
    },
    "schema": {
      "const": "agentnet.relationship-consent-transaction.v1",
      "default": "agentnet.relationship-consent-transaction.v1",
