    "subordinate_owner_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Subordinate Owner Id",
      "type": "string"
    },
    "subordinate_owner_kind": {
      "enum": [
        "human",
        "guest"
      ],
      "title": "Subordinate Owner Kind",
      "type": "string"
    },
    "transaction_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Transaction Id",
      "type": "string"
    }
